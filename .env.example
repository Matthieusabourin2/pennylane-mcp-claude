# Copier ce fichier en .env, puis remplir. Le .env ne doit jamais être commité (.gitignore le bloque).

# ── Accès Pennylane ─────────────────────────────────────────────────────────
# Company API Token : Pennylane → Paramètres → Connectivité → Développeurs.
PENNYLANE_API_TOKEN=
# Alternative multi-dossiers : un fichier dossiers.json (un jeton par dossier) à la
# place de PENNYLANE_API_TOKEN. Voir docs/amont-README.md.
# PENNYLANE_CONFIG_PATH=/app/dossiers.json

# ── Mode serveur (claude.ai web et mobile) ──────────────────────────────────
# Inutile en local avec Claude Desktop ou Claude Code (transport stdio).
# Nom de domaine qui pointe vers la machine (enregistrement DNS A ou AAAA).
MCP_DOMAIN=pennylane.mondomaine.fr
# Adresse publique HTTPS, sans slash final : https:// suivi de MCP_DOMAIN.
MCP_PUBLIC_URL=https://pennylane.mondomaine.fr
# Mot de passe de la page de consentement ET jeton pour Claude Code.
# Générer : openssl rand -base64 32
MCP_BEARER_TOKEN=
# Seulement si le mot de passe de consentement doit différer du jeton :
# MCP_OAUTH_PASSWORD=
